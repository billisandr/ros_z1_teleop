<launch>
    <!-- =====================================================================
         Z1 Hand-Teleop Station — primary launch (Gazebo arm + MediaPipe hand
         follower). Perception is a REAL image stream (host webcam or a looping
         video file); there is no animated hand inside Gazebo.

         Camera source is selected by the image_source arg (default webcam):
           image_source:=webcam
           image_source:=video:/path/to/hand.mp4
           image_source:=external      (another node publishes the image topic)
         See PLAN.md §9 / the README for the Windows camera reality check.
         ===================================================================== -->

    <!-- Load station config into the parameter server -->
    <rosparam file="$(find z1_teleop)/config/teleop.yaml" command="load"/>

    <arg name="rname"            default="z1"/>
    <arg name="robot_path"       value="(find $(arg rname)_description)"/>
    <arg name="dollar"           value="$"/>
    <arg name="debug"            default="false"/>
    <arg name="UnitreeGripperYN" default="true"/>
    <!-- Real wall-clock image stream -> no sim time (avoids TF/clock skew) -->
    <arg name="use_sim_time"     default="false"/>
    <arg name="paused"           default="true"/>
    <arg name="gui"              default="true"/>
    <arg name="headless"         default="false"/>

    <!-- Camera source for image_source_node (overrides hand/image_source in yaml) -->
    <arg name="image_source"     default="webcam"/>
    <param name="hand/image_source" value="$(arg image_source)"/>

    <!-- Gazebo world — arm only, no marker, no virtual camera -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name"   value="$(find z1_teleop)/worlds/teleop.world"/>
        <arg name="debug"        value="$(arg debug)"/>
        <arg name="gui"          value="$(arg gui)"/>
        <arg name="paused"       value="$(arg paused)"/>
        <arg name="headless"     value="$(arg headless)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>

    <!-- Load the Z1 URDF. The default hand-mirror uses no camera TF, so the
         wrist camera link is off (EndEffectorCamera:=false). -->
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '$(find z1_teleop)/xacro/z1_teleop_robot.xacro'
           UnitreeGripper:=$(arg UnitreeGripperYN)
           EndEffectorCamera:=false"/>

    <!-- Spawn the Z1 arm -->
    <node pkg="gazebo_ros" type="spawn_model" name="urdf_spawner" respawn="false" output="screen"
          args="-urdf -z 0.0 -model $(arg rname)_gazebo -param robot_description -unpause"/>

    <!-- Load joint controller config -->
    <rosparam file="$(arg dollar)$(arg robot_path)/config/robot_control.yaml" command="load"/>

    <!-- Spawn joint controllers (+ gripper_controller when the gripper is on) -->
    <group unless="$(arg UnitreeGripperYN)">
        <node pkg="controller_manager" type="spawner" name="controller_spawner" respawn="false"
            output="screen" ns="/$(arg rname)_gazebo" args="joint_state_controller
            Joint01_controller Joint02_controller Joint03_controller
            Joint04_controller Joint05_controller Joint06_controller"/>
    </group>
    <group if="$(arg UnitreeGripperYN)">
        <node pkg="controller_manager" type="spawner" name="controller_spawner" respawn="false"
            output="screen" ns="/$(arg rname)_gazebo" args="joint_state_controller
            Joint01_controller Joint02_controller Joint03_controller
            Joint04_controller Joint05_controller Joint06_controller
            gripper_controller"/>
    </group>

    <!-- Robot state publisher -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
          respawn="false" output="screen">
        <remap from="/joint_states" to="/$(arg rname)_gazebo/joint_states"/>
    </node>

    <!-- Image source: webcam / looping video file (idles if external) -->
    <node pkg="z1_hand_detector" type="image_source_node.py" name="image_source"
          output="screen"/>

    <!-- Hand detector (MediaPipe) -->
    <node pkg="z1_hand_detector" type="hand_detector_node.py" name="hand_detector"
          output="screen"/>

    <!-- Arm tracker (IK + gripper passthrough) -->
    <node pkg="z1_arm_tracker" type="arm_tracker_node.py" name="arm_tracker"
          output="screen"/>

    <!-- Optional scene props (gated by scene_objects/enabled in teleop.yaml) -->
    <include file="$(find z1_teleop)/launch/scene_objects.launch"/>

</launch>
