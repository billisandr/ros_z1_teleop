<launch>
    <env name="GAZEBO_MODEL_PATH" value="$(find z1_aruco)/models:$(optenv GAZEBO_MODEL_PATH)"/>

    <!-- Load config into ROS parameter server -->
    <rosparam file="$(find z1_aruco)/config/aruco_tracking.yaml" command="load"/>

    <!-- Override aruco/{dictionary,marker_size,tracking_id} from the YAML defaults above,
         for physical markers that don't match the repo's default (DICT_4X4_50, ID 0, 5cm).
         Defaults here match the YAML, so omitting these changes nothing.
         Set via start_zed_sim.sh's dictionary/marker size/tracking id flags. -->
    <arg name="aruco_dictionary"  default="DICT_4X4_50"/>
    <arg name="aruco_marker_size" default="0.05"/>
    <arg name="aruco_tracking_id" default="0"/>
    <param name="aruco/dictionary"  value="$(arg aruco_dictionary)"/>
    <param name="aruco/marker_size" value="$(arg aruco_marker_size)" type="double"/>
    <param name="aruco/tracking_id" value="$(arg aruco_tracking_id)" type="int"/>

    <arg name="rname"            default="z1"/>
    <arg name="robot_path"       value="(find $(arg rname)_description)"/>
    <arg name="dollar"           value="$"/>
    <arg name="debug"            default="false"/>
    <arg name="UnitreeGripperYN" default="true"/>
    <arg name="use_sim_time"     default="false"/>
    <arg name="paused"           default="true"/>
    <arg name="gui"              default="true"/>
    <arg name="headless"         default="false"/>

    <!-- Gazebo world — no ArUco marker model, no virtual camera -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name"   value="$(find z1_aruco)/worlds/aruco_tracking_real.world"/>
        <arg name="debug"        value="$(arg debug)"/>
        <arg name="gui"          value="$(arg gui)"/>
        <arg name="paused"       value="$(arg paused)"/>
        <arg name="headless"     value="$(arg headless)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    </include>

    <!-- Load the Z1 URDF from z1_aruco/xacro — our copy with EndEffectorCamera + CameraPlugin args.
         EndEffectorCamera:=true  — camera_color_optical_frame stays in the kinematic chain.
         CameraPlugin:=false      — Gazebo sensor plugin suppressed; the ZED bridge node below
         provides images instead. -->
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '$(find z1_aruco)/xacro/z1_aruco_robot.xacro'
           UnitreeGripper:=$(arg UnitreeGripperYN)
           EndEffectorCamera:=true
           CameraPlugin:=false"/>

    <!-- Spawn the Z1 arm -->
    <node pkg="gazebo_ros" type="spawn_model" name="urdf_spawner" respawn="false" output="screen"
          args="-urdf -z 0.0 -model $(arg rname)_gazebo -param robot_description -unpause"/>

    <!-- Load joint controller config -->
    <rosparam file="$(arg dollar)$(arg robot_path)/config/robot_control.yaml" command="load"/>

    <!-- Spawn joint controllers -->
    <group unless="$(arg UnitreeGripperYN)">
        <node pkg="controller_manager" type="spawner" name="controller_spawner" respawn="false"
            output="screen" ns="/$(arg rname)_gazebo" args="joint_state_controller
            Joint01_controller Joint02_controller Joint03_controller
            Joint04_controller Joint05_controller Joint06_controller"/>
    </group>
    <group if="$(arg UnitreeGripperYN)">
        <node pkg="controller_manager" type="spawner" name="controller_spawner" respawn="false"
            output="screen" ns="/$(arg rname)_gazebo" args="joint_state_controller
            Joint01_controller Joint02_controller Joint03_controller
            Joint04_controller Joint05_controller Joint06_controller
            gripper_controller"/>
    </group>

    <!-- Robot state publisher — broadcasts TF including camera_color_optical_frame → link06 -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"
          respawn="false" output="screen">
        <remap from="/joint_states" to="/$(arg rname)_gazebo/joint_states"/>
    </node>

    <!-- ZED 2 camera bridge — raw UVC capture via OpenCV/V4L2, no ZED SDK.
         Crops the side-by-side stereo frame to one eye and republishes on the same
         /camera/color/image_raw + /camera/color/camera_info topics the RealSense
         driver uses, so aruco_detector_node needs no changes.
         Settings (device/width/height/fps/eye) come from the zed_camera: section of
         aruco_tracking.yaml, loaded above — edit there, not here, to change them.
         width/height/fps MUST match a mode confirmed clean with ffplay first — see
         docs/DOCKER_CMDS.md#diagnosing-corruptedgarbled-video-over-usbipd-windows.
         Intrinsics are a rough FOV-based estimate, not factory calibration. -->
    <node pkg="z1_aruco_detector" type="zed_camera_node.py" name="zed_camera" output="screen"/>

    <!-- ArUco detector -->
    <node pkg="z1_aruco_detector" type="aruco_detector_node.py" name="aruco_detector"
          output="screen"/>

    <!-- Arm tracker -->
    <node pkg="z1_arm_tracker" type="arm_tracker_node.py" name="arm_tracker"
          output="screen"/>

</launch>
